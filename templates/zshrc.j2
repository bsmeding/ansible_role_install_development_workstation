# Zsh configuration
export PATH=$HOME/bin:/usr/local/bin:$PATH

{% if install_ohmyzsh %}
# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Set name of the theme to load
# See https://github.com/ohmyzsh/ohmyzsh/wiki/Themes
ZSH_THEME="{{ ohmyzsh_theme }}"

# Enable plugins
plugins=({% for plugin in ohmyzsh_plugins %}{{ plugin }}{% if not loop.last %} {% endif %}{% endfor %})

# Source Oh My Zsh
source $ZSH/oh-my-zsh.sh
{% endif %}

# Set editor and environment
export EDITOR={{ preferred_editor }}
export VISUAL={{ preferred_editor }}

# Color scheme (if enabled)
{% if os_settings.color_scheme %}
# Configure zsh-syntax-highlighting styles (must be set after oh-my-zsh is sourced)
if [[ -n "$ZSH_HIGHLIGHT_STYLES" ]]; then
  ZSH_HIGHLIGHT_STYLES[command]='fg=cyan,bold'
  ZSH_HIGHLIGHT_STYLES[builtin]='fg=cyan,bold'
  ZSH_HIGHLIGHT_STYLES[function]='fg=cyan,bold'
fi
{% endif %}

# =============================================================================
# Common Aliases
# =============================================================================

# File & Directory Navigation
alias ll="ls -lh"
alias la="ls -lah"
alias l="ls -CF"
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias ~="cd ~"
alias -- -="cd -"

# Git Aliases
alias gs="git status"
alias ga="git add"
alias gaa="git add --all"
alias gc="git commit"
alias gcm="git commit -m"
alias gca="git commit --amend"
alias gp="git push"
alias gpu="git push -u origin"
alias gpl="git pull"
alias gf="git fetch"
alias gfo="git fetch origin"
alias gb="git branch"
alias gba="git branch -a"
alias gbd="git branch -d"
alias gco="git checkout"
alias gcb="git checkout -b"
alias gd="git diff"
alias gds="git diff --staged"
alias gl="git log --oneline --graph --decorate"
alias glog="git log --oneline --graph --decorate --all"
alias gst="git stash"
alias gstp="git stash pop"
alias gm="git merge"
alias gr="git remote"
alias grv="git remote -v"
alias greset="git reset --hard"
alias gclean="git clean -fd"
alias gtag="git tag"
alias gshow="git show"

# Docker Aliases
alias d="docker"
alias dc="docker compose"
alias dps="docker ps"
alias dpsa="docker ps -a"
alias di="docker images"
alias dex="docker exec -it"
alias drm="docker rm"
alias drmi="docker rmi"
alias dstop="docker stop"
alias dstart="docker start"
alias dlogs="docker logs -f"
alias dprune="docker system prune -a"

# Kubernetes Aliases
alias k="kubectl"
alias kgp="kubectl get pods"
alias kgs="kubectl get services"
alias kgd="kubectl get deployments"
alias kga="kubectl get all"
alias kdel="kubectl delete"
alias kdes="kubectl describe"
alias klogs="kubectl logs -f"
alias kexec="kubectl exec -it"

# System Aliases
alias h="history"
alias hg="history | grep"
alias c="clear"
alias reload="exec $SHELL -l"
alias path='echo -e ${PATH//:/\\n}'

# Network Aliases
alias myip="curl ifconfig.me"
alias ports="netstat -tulanp"

# Process Management
alias psg="ps aux | grep -v grep | grep -i -e VSZ -e"

# Ansible Aliases
alias ap="ansible-playbook"
alias av="ansible-vault"
alias ag="ansible-galaxy"

# Development Aliases
alias python="python3"
alias pip="pip3"

